# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha os valores.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Banco de dados Postgres serverless (grátis em https://neon.tech)
# Em produção (Vercel) é OBRIGATÓRIO. Sem ele o site roda em modo demo local.
DATABASE_URL=

# Segredo para assinar as sessões (troque por algo aleatório e longo!)
SESSION_SECRET=troque-isto-por-um-segredo-longo-e-aleatorio

# Senha do painel admin em /acess/auth/adm  →  TROQUE ESTA SENHA!
ADMIN_PASSWORD=562626

# URL pública do site (usada em SEO, sitemap e compartilhamento)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Hospedagem de fotos (repositório de dados no GitHub) ──
# 1) Crie um repositório PÚBLICO só para as imagens (ex: seu-usuario/jrway-dados)
# 2) Gere um token fine-grained (Settings → Developer settings → Fine-grained tokens)
#    com acesso SÓ a esse repositório e permissão "Contents: Read and write"
# 3) As imagens são convertidas para WebP e enviadas por lá; a URL pública
#    usa a CDN jsDelivr (https://cdn.jsdelivr.net/gh/...).
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
# Opcional: outra CDN/base de leitura (padrão: jsDelivr do repo acima)
# GITHUB_CDN_BASE=https://cdn.jsdelivr.net/gh/SEU-USUARIO/jrway-dados@main
